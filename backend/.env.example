# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas)
# Replace with your actual MongoDB connection string in .env
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/kozhihood?retryWrites=true&w=majority

# JWT Secret Key for Token Generation and Verification
# Replace with a secure random string in .env
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS
CLIENT_ORIGIN=http://localhost:5173
