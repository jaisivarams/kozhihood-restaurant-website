<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Kozhihood Public Sitemap
  When production domain is deployed, replace the baseUrl placeholder prefix (e.g., https://kozhihood.com)
  Only contains public, crawlable routes: /, /menu, /reviews.
  Excludes private/admin routes (/login, /admin/reviews).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/menu</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>/reviews</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
